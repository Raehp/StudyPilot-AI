# StudyPilot AI 部署环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，绝不提交 Git）
#   cp .env.example .env
# 所有密钥仅注入后端容器；前端不接触任何密钥。

# ---- MySQL ----
# root 密码（仅容器初始化/健康检查使用）
MYSQL_ROOT_PASSWORD=change-me-root-strong-password
# 应用连接账号（容器自动创建并授权 studypilot 库）
MYSQL_USERNAME=studypilot
MYSQL_PASSWORD=change-me-app-strong-password

# ---- Redis ----
# 默认空：Redis 仅在内部 docker 网络运行，不对外发布端口
REDIS_PASSWORD=

# ---- 安全（必填，生产必须覆盖默认开发密钥）----
# 强随机值，建议 >= 32 字节，例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# ---- AI（必填，仅后端使用；绝不写入前端/Git/日志）----
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ---- 运行参数 ----
RATE_LIMIT_ENABLED=true
FRONTEND_PORT=80
JAVA_OPTS=-Xms256m -Xmx512m